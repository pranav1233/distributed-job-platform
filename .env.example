# Copy to .env and adjust. Never commit the real file.

# Datastores
DATABASE_URL=postgresql+asyncpg://jobs:jobs@localhost:5432/jobs
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# API
API_HOST=0.0.0.0
API_PORT=8000
DEFAULT_RATE_LIMIT_CAPACITY=100
DEFAULT_RATE_LIMIT_REFILL_PER_SEC=50
CACHE_TTL_ACTIVE_SECONDS=3
CACHE_TTL_TERMINAL_SECONDS=300

# Worker
WORKER_CONCURRENCY=16
WORKER_PREFETCH=32
WORKER_CPU_PROCESSES=2
LEASE_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10
SHUTDOWN_GRACE_SECONDS=20
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=300

# Relay and reaper
RELAY_POLL_INTERVAL_SECONDS=0.05
RELAY_BATCH_SIZE=200
REAPER_INTERVAL_SECONDS=2
OUTBOX_RETENTION_SECONDS=3600

# Observability
LOG_LEVEL=INFO
LOG_JSON=true
