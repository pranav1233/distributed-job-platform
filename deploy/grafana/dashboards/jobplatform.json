        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, type) (rate(job_duration_seconds_bucket{outcome=\"succeeded\"}[1m])))",
          "legendFormat": "p50 {{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, type) (rate(job_duration_seconds_bucket{outcome=\"succeeded\"}[1m])))",
          "legendFormat": "p95 {{type}}",
