        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, type) (rate(job_duration_seconds_bucket{outcome=\"succeeded\"}[1m])))",
          "legendFormat": "p99 {{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
