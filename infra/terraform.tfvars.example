# Copy to terraform.tfvars (ignored by git) and adjust.
region      = "us-east-1"
environment = "dev"

# Set after pushing the first image to ECR.
image_tag = "latest"

# Optional: serve HTTPS and receive alarm emails.
# certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."
# alarm_email     = "ops@example.com"

# Sizing for a small environment.
api_desired_count    = 2
worker_desired_count = 2
db_instance_class    = "db.t4g.micro"
